@url = http://localhost:3000
@user = {{url}}/api/users
@subject = {{url}}/api/subjects
@enrollment = {{url}}/api/enrollments

# Reemplazar "url" por "[nombre]-rmib.vercel.app" de Vercel una vez deployado

# IMPORTANTE: después de correr "Registrar profesor" y "Registrar alumno",
# copiá el "token" de cada respuesta y pegalo abajo en @tokenProf / @tokenAlu.
# El REST Client no encadena respuestas automáticamente, así que este paso
# manual es necesario cada vez que reiniciás la DB o cambian los usuarios.
@tokenProf = PEGAR_TOKEN_DEL_PROFESOR_ACA
@tokenAlu = PEGAR_TOKEN_DEL_ALUMNO_ACA

#===================
#    HEALTH / DB
#===================

### Chequeo de salud del servidor
GET {{url}}/health

#===================
#    AUTH
#===================

### Registrar un profesor
# Esperado: 201 con user + token. Copiar el token en @tokenProf arriba.
POST {{url}}/auth/register
Content-Type: application/json

{
    "name": "Profesor Test",
    "email": "proasf@test.com",
    "password": "1234",
    "role": "STUDENT"
}

### Registrar un alumno
# Esperado: 201 con user + token (role default STUDENT). Copiar en @tokenAlu.
POST {{url}}/auth/register
Content-Type: application/json

{
    "name": "Aluss Test",
    "email": "aluMssN@test.com",
    "password": "1234"
}

### Login como profesor
# Esperado: 201, mismo tipo de respuesta que register.
POST {{url}}/auth/login
Content-Type: application/json

{
    "email": "prof@test.com",
    "password": "1234"
}

#===================
#    TEST USERS
#===================

### Obtener todos los usuarios (requiere cualquier token válido)
GET {{user}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0

### Obtener solo estudiantes
GET {{user}}/students
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0

### Actualizar un usuario (reemplazar el :id por uno real)
PUT {{user}}/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0
Content-Type: application/json

{
    "name": "Jorge"
}

### Eliminar un usuario (soft delete, reemplazar el :id)
DELETE {{user}}/2
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0

#==========================
#       TEST MATERIAS
#==========================

### Crear materia SIN token -> esperado 401
POST {{subject}}
Content-Type: application/json

{
    "name": "Materia sin token"
}

### Crear materia con token de ALUMNO -> esperado 403
POST {{subject}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTIsInJvbGUiOiJTVFVERU5UIiwiaWF0IjoxNzg3NzAxMjQ3LCJleHAiOjE3ODc3MDQ4NDd9.vnIgxZOeX1-DxoZvu-k2jf1JQwBfZ0yhGMA1uTlkOto
Content-Type: application/json

{
    "name": "Materia con alumno"
}

### Crear materia con token de PROFESOR -> esperado 201
# Reemplazar professor_id por el id real devuelto en el registro del profesor
POST {{subject}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTMsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MTk3NTYsImV4cCI6MTc4NzcyMzM1Nn0.V24HwsVaL4WGy8dsiKppVxwmWwYuuuExC8Z_cwxogYs
Content-Type: application/json

{
    "name": "Organizacion y Arquitectura II",
    "description": "Funcionamiento interno de procesadores, cache y ram",
    "professor_id": 11
}

### Obtener todas las materias (cualquier logueado)
GET {{subject}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTIsInJvbGUiOiJTVFVERU5UIiwiaWF0IjoxNzg3NzAxMjQ3LCJleHAiOjE3ODc3MDQ4NDd9.vnIgxZOeX1-DxoZvu-k2jf1JQwBfZ0yhGMA1uTlkOto

### Actualizar materia (solo profesor)
PUT {{subject}}/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0
Content-Type: application/json

{
    "name": "Matemáticas Avanzadas",
    "description": "Cálculo integral y diferencial"
}

### Eliminar materia (solo profesor)
DELETE {{subject}}/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0

#======================================
#   TEST RELACIONES profesor-materia-alumno
#======================================

### Materias de un profesor específico
GET {{subject}}/professor/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0

### Profesor de una materia específica
GET {{subject}}/1/professor
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0

### Materias de un alumno específico
GET {{subject}}/student/2
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTIsInJvbGUiOiJTVFVERU5UIiwiaWF0IjoxNzg3NzAxMjQ3LCJleHAiOjE3ODc3MDQ4NDd9.vnIgxZOeX1-DxoZvu-k2jf1JQwBfZ0yhGMA1uTlkOto

### Materia completa (con profesor y estudiantes inscriptos)
GET {{subject}}/1/full
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTEsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MDExNTgsImV4cCI6MTc4NzcwNDc1OH0.Y77DTzSlJ0mvPGHctlPXVT-dDKCfY6ILnb2_VJxJPL0

#==========================
#       TEST ENROLLMENTS
#==========================

### Inscribir alumno en materia
# Reemplazar student_id/subject_id por ids reales
### Inscribir alumno en materia (solo profesor)
POST {{enrollment}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MTMsInJvbGUiOiJQUk9GRVNTT1IiLCJpYXQiOjE3ODc3MTk3NTYsImV4cCI6MTc4NzcyMzM1Nn0.V24HwsVaL4WGy8dsiKppVxwmWwYuuuExC8Z_cwxogYs
Content-Type: application/json

{
    "student_id": 14,
    "subject_id": 6
}

### Obtener todas las inscripciones
GET {{enrollment}}

### Obtener inscripción específica
GET {{enrollment}}/1

### Obtener inscripciones de un alumno
GET {{enrollment}}/student/2

### Obtener inscripciones de una materia
GET {{enrollment}}/subject/1

# ### Actualizar nota de una inscripción
# PUT {{enrollment}}/1
# Content-Type: application/json

# {
#     "grade": 9.5
# }

### Eliminar inscripción (soft delete)
DELETE {{enrollment}}/1

### Probar rate limit de auth (mandar 11 veces seguidas)
POST {{url}}/auth/login
Content-Type: application/json

{
    "email": "prof@test.com",
    "password": "1234"
}